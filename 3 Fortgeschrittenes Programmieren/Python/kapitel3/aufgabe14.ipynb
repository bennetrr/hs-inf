   "source": [
    "def haeufigkeiten(s: str) -> dict[str, int]:\n",
    "    r = {}\n",
    "    \n",
    "    for b in s:\n",
    "        if b in r:\n",
    "            r[b] += 1\n",
    "        else:\n",
    "            r[b] = 1\n",
    "            \n",
    "    return r"
   ],
   "outputs": [],
