{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "P0 debuggen (ab main)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "qemu",
      "serverpath": "qemu-system-arm",
      "cpu": "cortex-m4",
      "machine": "netduinoplus2",
      "executable": "${workspaceFolder}/build/p0.elf",
      "gdbPath": "gdb-multiarch",
      "cwd": "${workspaceFolder}",
      "runToEntryPoint": "main",
      "preLaunchTask": "make"
    },
    {
      "name": "P0 debuggen (ab Reset)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "qemu",
      "serverpath": "qemu-system-arm",
      "cpu": "cortex-m4",
      "machine": "netduinoplus2",
      "executable": "${workspaceFolder}/build/p0.elf",
      "gdbPath": "gdb-multiarch",
      "cwd": "${workspaceFolder}",
      "breakAfterReset": true,
      "preLaunchTask": "make"
    }
  ]
}
